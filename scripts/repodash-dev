#!/usr/bin/env bash
# Rebuild the development checkout before launching, preserving the caller's cwd.
set -euo pipefail

launcher_path=$(readlink -f -- "${BASH_SOURCE[0]}")
repo_root=$(dirname -- "$(dirname -- "$launcher_path")")
go_command=${GO:-go}

# /tmp is shared, so only trust paths owned by this user and not writable by others.
owned_private() {
    local path
    for path in "$@"; do
        [[ ! -e "$path" ]] && continue
        [[ -O "$path" && ! -L "$path" ]] || return 1
        (( (8#$(stat -c '%a' -- "$path") & 8#022) == 0 )) || return 1
    done
}

if ! command -v -- "$go_command" >/dev/null 2>&1; then
    # Reuse the toolchain documented in README for this development environment.
    if [[ "$go_command" == go && -x /tmp/repodash-toolchain/go/bin/go ]] &&
        [[ -d /tmp/repodash-toolchain ]] &&
        owned_private /tmp/repodash-toolchain /tmp/repodash-toolchain/go \
            /tmp/repodash-toolchain/go/bin /tmp/repodash-toolchain/go/bin/go \
            "${GOCACHE:-/tmp/repodash-gocache}" "${GOPATH:-/tmp/repodash-gopath}"; then
        go_command=/tmp/repodash-toolchain/go/bin/go
        export PATH="/tmp/repodash-toolchain/go/bin:$PATH"
        export GOCACHE="${GOCACHE:-/tmp/repodash-gocache}"
        export GOPATH="${GOPATH:-/tmp/repodash-gopath}"
    else
        printf 'repodash: Go compiler unavailable (%s). Install Go or set GO to its executable path.\n' "$go_command" >&2
        exit 1
    fi
fi

mkdir -p -- "$repo_root/bin"
build_dir=$(mktemp -d "$repo_root/bin/.dev-build.XXXXXX")
trap 'rm -rf -- "$build_dir"' EXIT

# Go's cache makes unchanged launches inexpensive. Failed builds leave the last
# good binary intact, but stop this launch so stale code is never run silently.
"$go_command" -C "$repo_root" build -o "$build_dir/repodash" ./cmd/repodash
mv -f -- "$build_dir/repodash" "$repo_root/bin/repodash"
rm -rf -- "$build_dir"
trap - EXIT
exec "$repo_root/bin/repodash" "$@"
